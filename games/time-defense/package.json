{
  "name": "time-defense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "verify:build": "node tools/check-build.mjs artifacts/build-verification.json",
    "prepare:site": "node tools/prepare-site.mjs",
    "preview:site": "node tools/preview-site.cjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
