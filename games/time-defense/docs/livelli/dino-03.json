  "tutorial": [
    {
      "id": "swamp-paths",
      "when": "first-preparation",
      "text": "Nord e Sud sono annunciati per ogni gruppo. Confronta i raggi su entrambi. Le specializzazioni di Resina e Spore sono alternative: dopo un ramo non si passa all'altro senza vendere e ricostruire."
    },
    {
      "id": "swamp-pack",
      "when": "before-wave-2",
      "text": "Branco: tre creature piccole, ciascuna con Carica 14, velocità 64 e fuga 1. Ogni individuo è un bersaglio distinto: il gruppo non condivide Carica o ricompensa."
    },
    {
      "id": "swamp-five",
      "when": "before-wave-5",
      "phaseLabel": "Prima della quinta ondata",
      "text": "Ora il Branco conta cinque individui. Nube copre un'area, Parassita al massimo due bersagli distinti. La densità aiuta l'area, ma conta il tempo dentro la nube."
    },
    {
      "id": "swamp-guado",
      "when": "before-wave-6",
      "phaseLabel": "Prima della sesta ondata",
      "text": "Qui Guado segue il sentiero Sud: questa mappa non ha un ramo acquatico. Velocità 46, nessuna Protezione e fuga 2 come al Fiume."
    }
  ]
