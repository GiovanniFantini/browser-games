  "tutorial": [
    {
      "id": "rift-finite",
      "when": "first-preparation",
      "text": "Il percorso entra una sola volta nel portale centrale. Le torri vicine a pi\u00f9 tratti possono coprirli in momenti diversi: controlla i raggi senza confondere la somma delle esposizioni con un attacco continuo."
    },
    {
      "id": "rift-spread",
      "when": "before-wave-9",
      "phaseLabel": "Prima della nona ondata",
      "text": "Il Custode arriver\u00e0 dopo questa ondata. Puoi mettere in pausa e distribuire le difese. La coda colpisce al massimo due torri, non tutto l'arsenale; gli attacchi gi\u00e0 partiti continuano."
    },
    {
      "id": "rift-boss",
      "when": "before-wave-10",
      "phaseLabel": "Prima dell'ondata del Custode",
      "text": "Il Custode cambia comportamento a 780 e 360 Carica, senza curarsi. Se raggiunge il portale perdi subito. Guarda gli avvisi di ruggito e coda; puoi sempre mettere in pausa e leggere i dettagli."
    },
    {
      "id": "rift-release",
      "when": "boss-neutralized",
      "phaseLabel": "Dopo la liberazione, se restano ingressi o creature",
      "text": "Il Custode \u00e8 libero. Proteggi ancora il portale: la vittoria richiede di risolvere tutti gli accompagnatori e gli ingressi dichiarati."
    }
  ]
