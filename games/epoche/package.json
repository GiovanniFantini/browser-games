{
  "name": "epoche",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write src tools tests vite.config.ts eslint.config.mjs index.html",
    "sim": "tsx tools/sim/run.ts",
    "sim:check": "tsx tools/sim/checks.ts",
    "test:update-determinism": "tsx tools/sim/updateDeterminism.ts",
    "sim:campaign": "tsx tools/sim/campaign.ts",
    "desktop:build": "tauri build",
    "desktop:info": "tauri info"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "pixi.js": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
