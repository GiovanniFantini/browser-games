  "tutorial": [
    {
      "id": "plateau-fronts",
      "when": "first-preparation",
      "text": "I1 e I2 sono ingressi diversi, con un portale comune. Confronta i raggi sui due fronti. Roccia e rami del Nido sono sbloccati, ma puoi continuare con le difese che conosci."
    },
    {
      "id": "plateau-stone",
      "when": "before-wave-2",
      "text": "Roccia ha raggio corto e ignora 15 punti di Protezione fisica; Spore resta un'alternativa contro la corazza. Frantuma riduce la Protezione per tutti dopo il proprio colpo, non prima."
    },
    {
      "id": "plateau-support",
      "when": "before-wave-4",
      "text": "Richiamo: Carica 84, velocità 42, fuga 2. Il canto avvisa per 1 secondo e accelera del 25% soltanto le altre creature ammesse entro raggio 140. Neutralizzare la fonte toglie subito il bonus. Picchiata dà priorità ai Supporti anche quando non cantano."
    },
    {
      "id": "plateau-mix",
      "when": "before-wave-5",
      "phaseLabel": "Prima della quinta ondata",
      "text": "Stormo distribuisce gli attacchi su tre individui distinti. Sisma colpisce un'area, senza rallentare. Sono alternative, non acquisti obbligatori. Immobilizzare Richiamo non interrompe il canto."
    }
  ],
