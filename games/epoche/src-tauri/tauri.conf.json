{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epoche",
  "version": "0.2.0",
  "identifier": "games.browsergames.epoche",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5186 --strictPort",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5186",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Epoche",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
